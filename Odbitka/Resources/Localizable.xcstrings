    "error.generic.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        }
      }
    },
    "error.offline.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%d zdjęć jest przechowywanych w iCloud i trzeba je najpierw pobrać. Połącz się z internetem i spróbuj ponownie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d photos are stored in iCloud and need to be downloaded first. Connect to the internet and try again."
          }
        }
      }
    },
    "error.offline.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection"
          }
        }
      }
    },
    "error.part.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik %@ ma %@ i nie zmieści się w części o limicie %@. Podnieś limit części albo zmniejsz zdjęcia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ and won’t fit in a part limited to %@. Raise the part limit or make the photos smaller."
          }
        }
      }
    },
    "error.part.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik większy niż część"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File larger than a part"
          }
        }
      }
    },
    "error.read.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać pliku %@. Przebieg został przerwany, żeby paczka nie wyszła niekompletna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read %@. The run was stopped so you don’t end up with an incomplete batch."
          }
        }
      }
    },
    "error.read.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zdjęcia"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t read a photo"
          }
        }
      }
    },
    "error.space.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do przetworzenia potrzeba około %@, a wolne jest %@. Zwolnij miejsce albo wybierz mniej zdjęć."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing needs about %@, but only %@ is free. Free up space or choose fewer photos."
          }
        }
      }
    },
    "error.space.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
