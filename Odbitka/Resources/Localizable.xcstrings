{
  "sourceLanguage": "pl",
  "version": "1.0",
  "strings": {
    "appSettings.about.footer": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka — konwersja i przygotowanie zdjęć do wysłania, w całości na urządzeniu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka — converting and preparing photos to send, entirely on your device."
          }
        }
      }
    },
    "appSettings.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka nie ma serwera i nie wysyła nigdzie Twoich zdjęć. Jedyny ruch sieciowy to pobranie z iCloud zdjęć, których nie ma na urządzeniu — i robi to sam system, z Twojego konta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka has no server and never uploads your photos. The only network activity is iOS downloading from iCloud those photos that aren’t on the device — from your own account."
          }
        }
      }
    },
    "appSettings.section.about": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikacji"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "appSettings.section.privacy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "appSettings.section.storage": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce na dysku"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        }
      }
    },
    "appSettings.storage.clear": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść teraz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear now"
          }
        }
      }
    },
    "appSettings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetworzone zdjęcia żyją do końca sesji, żeby dało się wrócić i wysłać je jeszcze raz. Znikają same przy następnym uruchomieniu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed photos live until the end of the session so you can come back and send them again. They are cleared automatically on next launch."
          }
        }
      }
    },
    "appSettings.storage.used": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki robocze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working files"
          }
        }
      }
    },
    "appSettings.title": {
      "extractionState": "manual",
      "localizations": {
