      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka potrzebuje dostępu do biblioteki, żeby przygotować kopie zdjęć. Możesz go włączyć w Ustawieniach systemu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbitka needs access to your library to prepare copies of your photos. You can grant it in Settings."
          }
        }
