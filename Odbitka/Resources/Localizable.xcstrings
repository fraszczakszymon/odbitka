    "batch.footer": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj po jednej porcji. Odhaczone porcje to te, które udało się przekazać dalej — Odbitka nie wie, czy wiadomość faktycznie dotarła."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send one batch at a time. A checkmark means the batch was handed over — Odbitka cannot know whether the message actually arrived."
          }
        }
      }
    },
    "batch.header": {
      "extractionState": "manual",
      "localizations": {
