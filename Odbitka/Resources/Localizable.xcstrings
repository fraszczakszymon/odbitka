    "error.budget.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zejść poniżej %@ — najlepszy wynik to %@. Wybierz mniej zdjęć albo podnieś limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t get below %@ — the best result was %@. Choose fewer photos or raise the limit."
          }
        }
      }
    },
    "error.budget.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mieści się w limicie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t fit the limit"
          }
        }
      }
    },
    "error.cancelled.message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwarzanie zostało przerwane, a pliki częściowe usunięte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing was cancelled and partial files were removed."
